# App
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=true

# Supabase Postgres
# For a long-running FastAPI server, use the Supabase direct connection (IPv6) or
# the Shared Pooler session mode on port 5432 when IPv4 is required.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Admin authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_SEED_EMAIL=admin@greenbe.org
ADMIN_SEED_PASSWORD=replace-this-before-first-run
ADMIN_SEED_NAME=GreenBe Admin

# Supabase Storage (used for thumbnails and in-article images)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=blog-media
